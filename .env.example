# --- Database ---------------------------------------------------------------
# Production: Neon Postgres connection string (use the *pooled* URL).
# Local dev: leave unset to use an embedded PGlite database in ./.pglite
# DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (http://localhost:3000 locally, https://your-app.vercel.app in production).
# On Vercel it can be left unset: the app trusts its own Vercel addresses automatically.
BETTER_AUTH_URL=http://localhost:3000
# Extra addresses allowed to sign in, comma-separated (e.g. a custom domain)
# TRUSTED_ORIGINS=https://study.example.com
# Comma-separated emails that can sign in as parents
PARENT_EMAILS=kent.yunge@gmail.com

# --- Email (parent sign-in links) -------------------------------------------
# Without a key, sign-in links are printed to the server console (handy locally).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Homework Helper <helper@yourdomain.com>"

# --- Claude -----------------------------------------------------------------
# From console.anthropic.com. Without it, the tutor runs in demo mode (canned replies).
# Set a monthly spend limit in the Console under Settings -> Limits.
# ANTHROPIC_API_KEY=sk-ant-...
# TUTOR_MODEL=claude-opus-5-5        # or claude-sonnet-5-5 to spend about half as much
# GUARD_MODEL=claude-haiku-5-5       # the "did it give away the answer?" check

# --- Voice (optional) -------------------------------------------------------
# Browser voices work with no setup. For natural voices, add an ElevenLabs key and pick
# a voice id per kid on the parent page (or set a default here).
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_DEFAULT_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- App --------------------------------------------------------------------
# NEXT_PUBLIC_APP_NAME="Homework Helper"
